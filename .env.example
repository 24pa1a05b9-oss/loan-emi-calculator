# ===================================================================
# Loan EMI Calculator - Environment Configuration Example
# ===================================================================
# NOTE: Set these environment variables in your Vercel Project Settings:
# Settings > Environment Variables
# These variables are only accessed securely by Vercel Serverless Functions
# and are NEVER exposed to client-side frontend code.

# Supabase Project URL (e.g., https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project.supabase.co

# Supabase Service Role Key (Keep secret! Used by Vercel Serverless backend)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Optional: Supabase Anon Key (If using public anon policies)
SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Optional Frontend Override (leave empty to use Vercel relative /api routes)
# VITE_API_BASE_URL=
